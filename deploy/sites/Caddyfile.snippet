# Static-site hosting (<name>.s.xinduanju.top). Merge the global option into the existing global
# block at the top of /etc/caddy/Caddyfile and append the site block, then
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Certificates are issued on demand, one per site, only for names the backend confirms exist
# (GET /api/v1/sites/tls-check?domain=...). Let's Encrypt allows 50 new certificates per week per
# registered domain; switch to a DNS-01 wildcard certificate if more sites are created than that.

{
	on_demand_tls {
		ask http://localhost:8080/api/v1/sites/tls-check
	}
}

*.s.xinduanju.top, s.xinduanju.top {
	tls {
		on_demand
	}
	reverse_proxy localhost:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	encode {
		zstd
		gzip 6
		minimum_length 256
	}
	request_body {
		max_size 1MB
	}
	log {
		output file /var/log/caddy/sites.log {
			roll_size 50mb
			roll_keep 60
			roll_keep_for 2160h
		}
	}
}
