   "goal": "能在 IDE 里运行 WordCount 并停在任意一行",
   "weeks": "第 0 讲"
  },
  {
   "id": "L1",
   "title": "作业怎么跑起来",
   "desc": "从 API 调用到 Task 线程里的 processElement()。",
   "goal": "Web UI 上 Task 的个数，能说出是哪条规则决定的",
   "weeks": "第 1 讲"
  },
  {
   "id": "L2",
   "title": "Checkpoint",
   "desc": "不停数据流，怎么做全局一致的快照。",
   "goal": "能解释背压下 Checkpoint 为什么慢、非对齐快在哪、代价是什么",
   "weeks": "第 2 讲"
  },
  {
   "id": "L3",
   "title": "状态与扩缩容",
   "desc": "状态存在哪，改了并行度状态怎么切。",
   "goal": "能说清 maxParallelism 为什么不能改、RocksDB 为什么要 update()",
   "weeks": "第 3 讲"
  },
  {
   "id": "L4",
   "title": "网络与背压",
   "desc": "数据在 Task 之间怎么流，背压怎么传上去。",
   "goal": "给一组背压指标，能找出真正的瓶颈",
   "weeks": "第 4 讲"
  },
  {
   "id": "L5",
   "title": "Table / SQL",
   "desc": "一条 SQL 怎么变成 Java 代码，-U/+U 从哪来。",
   "goal": "能读懂执行计划，说出两阶段聚合为什么没生效",
   "weeks": "第 5 讲"
  },
  {
   "id": "L6",
   "title": "时间与窗口",
   "desc": "Watermark 从哪来、怎么传，窗口什么时候触发、什么时候清理。",
   "goal": "窗口不出结果、出了两次、晚了，都能定位原因",
   "weeks": "第 7 讲"
  },
  {
   "id": "L7",
   "title": "Source / Sink 与端到端 exactly-once",
   "desc": "split 怎么分、怎么收回，两阶段提交怎么和 Checkpoint 配合。",
   "goal": "能说出端到端 exactly-once 需要哪三个条件，以及 Committer 为什么要幂等",
   "weeks": "第 8 讲"
  },
  {
   "id": "L8",
   "title": "调度与容错",
   "desc": "Task 失败后重启谁、等多久、从哪恢复。",
   "goal": "能说出一次失败会重启几个 Task、隔多久重启",
   "weeks": "第 6 讲"
  },
  {
   "id": "L9",
   "title": "参与社区",
   "desc": "从读者到贡献者：提 JIRA、提 PR、AI 辅助的规则。",
   "goal": "按社区规则提交第一个 PR",
   "weeks": "第 9 讲"
  }
 ],
